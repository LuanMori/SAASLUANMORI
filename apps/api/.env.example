# apps/api/.env.example — copie para apps/api/.env (o .env NUNCA vai para o git)
# Em produção estes valores vêm da task definition do ECS + AWS Secrets Manager (Fase 8).

PORT=3000

# Conexão usada pela API em execução: role saas_app.
# NUNCA use aqui o usuário master do RDS nem um superusuário: eles ignoram o RLS.
# A senha precisa ser a mesma de SAAS_APP_DB_PASSWORD.
DATABASE_URL_APP=postgresql://saas_app:troque-por-uma-senha-longa@localhost:5432/saas_dev

# Conexão de migração (dona do schema). Só para prisma migrate e scripts/.
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/saas_dev

# Senha que `npm run db:app-role` aplica na role saas_app (mínimo 16 caracteres).
SAAS_APP_DB_PASSWORD=troque-por-uma-senha-longa

# Auth0 — ver docs/AUTH0.md
AUTH0_DOMAIN=seu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.seudominio.com.br

# Origens do frontend liberadas no CORS (separadas por vírgula)
WEB_ORIGINS=http://localhost:5173

# Só desenvolvimento: lojas ligadas às Organizations do Auth0 (Nome=org_id;...)
SEED_LOJAS=Loja A=org_xxxxxxxxxxxxxxxx;Loja B=org_yyyyyyyyyyyyyyyy

# Só testes automatizados: superusuário de um Postgres LOCAL (o teste cria/apaga bancos)
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
