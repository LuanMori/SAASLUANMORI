{
  "name": "@saas/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev:build": "prisma generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev": "node --watch-path=dist dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:down": "tsx scripts/migrate-down.ts",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:app-role": "tsx scripts/definir-senha-app.ts",
    "db:backup-role": "tsx scripts/criar-role-backup.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "db:usuario": "tsx scripts/cadastrar-usuario.ts",
    "pretest": "prisma generate",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@saas/core": "0.0.0",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
