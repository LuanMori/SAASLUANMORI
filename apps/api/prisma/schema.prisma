// apps/api/prisma/schema.prisma
// lojas, usuarios (com login próprio), sessoes, auditoria e produtos.
// Regras que o Prisma NÃO modela ficam no SQL das migrations (e são testadas):
//   - Row-Level Security (ENABLE + FORCE) e policies por loja_id em TODA tabela de loja
//     (test/rls-banco.spec.ts falha se uma tabela nova ficar sem)
//   - função app_loja_atual() e a trava de usuários (usuarios_trava_api)
//   - role saas_app e GRANTs mínimos (auditoria só acrescenta; ninguém apaga)
//   - CHECKs: super_admin <=> loja_id NULL, formato do subdomínio e do login

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  super_admin
  dono
  administrador
  vendedor

  @@map("papel")
}

/// Tenant. A loja é achada pelo SUBDOMÍNIO do endereço (lojaa.nomedaempresa.com.br -> "lojaa").
/// Sem RLS (é o cadastro de tenants). A API só tem SELECT nesta tabela.
model Loja {
  id           String   @id @default(uuid(7)) @db.Uuid
  nome         String   @db.VarChar(120)
  /// Só letras minúsculas, números e hífen (CHECK lojas_subdominio_formato).
  subdominio   String   @unique @db.VarChar(63)
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuarios  Usuario[]
  produtos  Produto[]
  sessoes   Sessao[]
  auditoria Auditoria[]

  @@map("lojas")
}

/// Pessoa que opera o sistema dentro de UMA loja. Só entra quem o Dono ou o Administrador
/// cadastrou (tela Usuários; o primeiro Dono, pelo script db:usuario). Login próprio: usuário + senha.
/// A mesma pessoa em duas lojas = duas linhas (uma por loja), com senhas independentes.
/// super_admin: loja_id NULL (garantido por CHECK no banco).
/// A trava usuarios_trava_api (trigger) impede, no próprio banco, que a API promova alguém a Dono
/// sem ser Dono, desative a si mesma ou deixe a loja sem Dono ativo.
model Usuario {
  id                String    @id @default(uuid(7)) @db.Uuid
  lojaId            String?   @map("loja_id") @db.Uuid
  /// Login, minúsculo (CHECK usuarios_usuario_formato). Único na loja.
  usuario           String    @db.VarChar(40)
  nome              String    @db.VarChar(120)
  papel             Papel     @default(vendedor)
  ativo             Boolean   @default(true)
  /// scrypt (apps/api/src/auth/senhas.ts). null = ainda sem senha (não entra).
  senhaHash         String?   @map("senha_hash") @db.VarChar(255)
  /// Senha criada/redefinida pelo Dono: no primeiro acesso a pessoa cria a dela.
  senhaProvisoria   Boolean   @default(true) @map("senha_provisoria")
  tentativasErradas Int       @default(0) @map("tentativas_erradas")
  bloqueadoAte      DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  ultimoAcessoEm    DateTime? @map("ultimo_acesso_em") @db.Timestamptz(3)
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm      DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  loja    Loja?    @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  sessoes Sessao[]

  @@unique([lojaId, usuario])
  @@map("usuarios")
}

/// Sessão de login. O segredo fica só no cookie (HttpOnly) do navegador; aqui fica o SHA-256 dele.
/// Expira por inatividade (30 min) ou depois de 12 h. Sair, desativar o usuário ou redefinir a
/// senha encerram a sessão. A API só lê, cria e encerra (não estende a validade).
model Sessao {
  id          String    @id @default(uuid(7)) @db.Uuid
  lojaId      String    @map("loja_id") @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  criadaEm    DateTime  @default(now()) @map("criada_em") @db.Timestamptz(3)
  ultimoUsoEm DateTime  @default(now()) @map("ultimo_uso_em") @db.Timestamptz(3)
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(3)
  encerradaEm DateTime? @map("encerrada_em") @db.Timestamptz(3)

  loja    Loja    @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([lojaId, usuarioId])
  @@map("sessoes")
}

/// Quem fez o quê, em qual loja e quando (docs/decisoes/0001-auditoria.md). Só acrescenta:
/// a API não altera nem apaga (sem GRANT de UPDATE/DELETE). Sem dado pessoal em `detalhes`:
/// nomes vêm de `usuarios` na hora de mostrar (assim a exclusão LGPD vale também aqui).
model Auditoria {
  id        String   @id @default(uuid(7)) @db.Uuid
  lojaId    String   @map("loja_id") @db.Uuid
  /// Quem fez (null = sistema).
  usuarioId String?  @map("usuario_id") @db.Uuid
  /// Chave de ACOES_AUDITORIA (@saas/core), ex.: "usuario.criado".
  acao      String   @db.VarChar(60)
  alvoTipo  String?  @map("alvo_tipo") @db.VarChar(40)
  alvoId    String?  @map("alvo_id") @db.Uuid
  detalhes  Json     @default("{}")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Restrict)

  @@index([lojaId, criadoEm(sort: Desc)])
  @@map("auditoria")
}

/// Regras fora do Prisma (CHECK na migration 20261111190000, testadas):
///   codigo_interno só dígitos · codigo_barras só dígitos · preco_centavos > 0.
/// Código interno e código de barras não podem coincidir dentro da loja
/// (o leitor do PDV aceita os dois): garantido pela API sob trava por loja.
model Produto {
  id            String   @id @default(uuid(7)) @db.Uuid
  lojaId        String   @map("loja_id") @db.Uuid
  /// Gerado pelo sistema: 0001, 0002, … (maior + 1). Único DENTRO da loja.
  codigoInterno String   @map("codigo_interno") @db.VarChar(18)
  /// Opcional, só números. Único DENTRO da loja (lojas diferentes podem repetir).
  codigoBarras  String?  @map("codigo_barras") @db.VarChar(64)
  nome          String   @db.VarChar(120)
  /// Dinheiro sempre em centavos inteiros. Maior que zero (brinde é dado na venda).
  precoCentavos Int      @map("preco_centavos")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Restrict)

  @@unique([lojaId, codigoInterno])
  @@unique([lojaId, codigoBarras])
  @@index([lojaId, nome])
  @@map("produtos")
}
