# apps/web/.env.example — copie para apps/web/.env (não versionar o .env)
# Nada aqui é segredo: tudo vai para o navegador. Mesmo assim, não versione.

# Domínio do tenant Auth0 (ou o custom domain, ex.: login.seudominio.com.br)
VITE_AUTH0_DOMAIN=seu-tenant.us.auth0.com
# Client ID da aplicação "Single Page Application" no Auth0
VITE_AUTH0_CLIENT_ID=
# Identifier da API cadastrada no Auth0 (igual a AUTH0_AUDIENCE da API)
VITE_AUTH0_AUDIENCE=https://api.seudominio.com.br
# Endereço da API
VITE_API_URL=http://localhost:3000
