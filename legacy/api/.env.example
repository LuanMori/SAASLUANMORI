# apps/api/.env.example — copie para apps/api/.env (o .env NUNCA vai para o git)
# Em produção estes valores vêm do .env.producao do docker-compose.prod.yml (docs/deploy.md).

PORT=3000

# Conexão usada pela API em execução: role saas_app.
# NUNCA use aqui o superusuário nem uma role com BYPASSRLS: a API confere ao subir e se recusa.
# A senha precisa ser a mesma de SAAS_APP_DB_PASSWORD.
DATABASE_URL_APP=postgresql://saas_app:troque-por-uma-senha-longa@localhost:5432/saas_dev

# Conexão de migração (dona do schema). Só para prisma migrate e scripts/.
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/saas_dev

# Senha que `npm run db:app-role` aplica na role saas_app (mínimo 16 caracteres).
SAAS_APP_DB_PASSWORD=troque-por-uma-senha-longa
# Senha da role do backup (`npm run db:backup-role`; só leitura). Mínimo 16 caracteres.
SAAS_BACKUP_DB_PASSWORD=troque-por-outra-senha-longa

# Cookie de sessão só por HTTPS. Em desenvolvimento (http://localhost) fica false.
COOKIE_SEGURO=false

# Domínio do SaaS (a loja vem do subdomínio: lojaa.nomedaempresa.com.br). Vazio em desenvolvimento:
# a tela manda o endereço da loja (VITE_LOJA, padrão lojaa).
DOMINIO_BASE=

# Minutos sem uso até a sessão cair (padrão 30) e horas até cair de qualquer jeito (padrão 12).
# SESSAO_INATIVIDADE_MIN=30
# SESSAO_MAXIMA_HORAS=12

# Origens de OUTRO endereço liberadas (com cookie) no CORS. Com o proxy do Vite (/api), nem precisa.
WEB_ORIGINS=http://localhost:5173

# erro | aviso | info | debug
LOG_NIVEL=info

# Só desenvolvimento: lojas pelo endereço (Nome=endereco;...). Depois: npm run db:usuario
SEED_LOJAS=Loja A=lojaa;Loja B=lojab

# Só testes automatizados: superusuário de um Postgres LOCAL (o teste cria/apaga bancos)
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
