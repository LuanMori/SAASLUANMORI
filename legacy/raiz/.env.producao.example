# .env.producao.example — copie para .env.producao no SERVIDOR (o .env.producao nunca vai para o git).
# Gere cada senha com:  openssl rand -hex 24
# Use só letras e números nas senhas (elas entram dentro de endereços de conexão).

# Postgres (superusuário: só o container de migração usa)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=saas

# Role da API (sem BYPASSRLS) e role do backup (só leitura). Mínimo 16 caracteres.
SAAS_APP_DB_PASSWORD=
SAAS_BACKUP_DB_PASSWORD=

# Domínio do SaaS: cada loja entra por <loja>.<DOMINIO_BASE> (ex.: lojaa.nomedaempresa.com.br).
# Vazio = a tela pede o endereço da loja no fim do link (?loja=lojaa) — só para teste.
DOMINIO_BASE=

# true em produção (cookie só por HTTPS). false só para testar por http:// sem HTTPS na frente.
COOKIE_SEGURO=true

# Porta do nginx neste servidor (o HTTPS na frente aponta para ela).
PORTA_HTTP=8080

# erro | aviso | info | debug
LOG_NIVEL=info

# Quantos dias de backup ficam neste servidor (deploy/backup.sh). Copie para fora também!
BACKUP_DIAS=14
