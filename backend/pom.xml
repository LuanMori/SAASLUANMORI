<?xml version="1.0" encoding="UTF-8"?>
<!--
  backend/pom.xml — o sistema reconstruído em Java + HTML + CSS (docs/migracao/PROMPT-MESTRE.md, seção 2.8):
  Java 21, Spring Boot 3.3.x, Spring Security com login próprio (scrypt + sessão em cookie HttpOnly, sem OAuth2),
  Spring Data JPA + Hibernate, Flyway, PostgreSQL, Thymeleaf, HTMX 1.9.x via WebJar, Bean Validation e JUnit 5.
  Verificação antes de qualquer commit: mvn -f backend/pom.xml verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>

  <groupId>com.saasluanmori</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>SAASLUANMORI backend</name>
  <description>Reconstrução do sistema em Java + HTML + CSS: Spring Boot, Thymeleaf e HTMX, multiempresa com RLS no PostgreSQL.</description>

  <properties>
    <java.version>21</java.version>
    <!-- fora do controle de versões do Spring Boot: fixadas aqui -->
    <htmx.version>1.9.12</htmx.version>
    <bouncycastle.version>1.87</bouncycastle.version>
  </properties>

  <dependencies>
    <!-- telas renderizadas no servidor -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>htmx.org</artifactId>
      <version>${htmx.version}</version>
    </dependency>
    <dependency>
      <!-- endereço do WebJar sem a versão (/webjars/htmx.org/dist/htmx.min.js) -->
      <groupId>org.webjars</groupId>
      <artifactId>webjars-locator-core</artifactId>
    </dependency>

    <!-- login próprio: o SCryptPasswordEncoder do Spring Security usa o scrypt do Bouncy Castle -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!-- dados: JPA + Hibernate, migrações com Flyway, PostgreSQL -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- testes: JUnit 5 + Spring Boot Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- regra 1.6: nenhum aviso de compilação passa em branco -->
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
